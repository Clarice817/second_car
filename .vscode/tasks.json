{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. CMake 配置 (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "2. 编译 (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "dependsOn": [
                "1. CMake 配置 (Debug)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "3. 下载到芯片 (OpenOCD + ST-Link)",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "program build/Debug/second_car.elf verify reset exit"
            ],
            "dependsOn": [
                "2. 编译 (Debug)"
            ],
            "problemMatcher": []
        }
    ]
}
